rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net — deny everything not explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Helper functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin is identified by the Firebase Auth account created in the console.
    // Email must match exactly; the password is managed by Firebase (bcrypt).
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@zanorispaces.com';
    }

    // ── Collections ───────────────────────────────────────────────────────

    // Portfolio case studies — publicly readable; only the admin account can
    // create, update, or delete entries.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boutique shop products — publicly readable; only the admin account can
    // create, update, or delete entries.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User wishlists — each document is private to the user who created it.
    match /wishlists/{wishlistId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() <= 128;
      allow update: if false; // Wishlist items are immutable after creation.
    }
  }
}
