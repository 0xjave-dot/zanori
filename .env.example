# GEMINI_API_KEY: Required for Gemini AI API calls (room reimagine feature).
# Configure this in your deployment environment / AI Studio secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Admin authentication is handled by Firebase Authentication — no env vars needed.
# To set the admin password:
#   1. Open the Firebase console → Authentication → Users → Add user
#   2. Email: admin@zanorispaces.com
#   3. Password: your chosen passcode (e.g. Kryptonitekiss2026!)
# Firebase stores it hashed (bcrypt). The password never touches your server or repo.
