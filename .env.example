# GEMINI_API_KEY: Required for Gemini AI API calls.
# Configure this in your deployment environment / secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD_HASH: scrypt hash of the admin passcode.
# NEVER commit the actual hash or plaintext password to the repo.
# Generate a fresh hash with:
#
#   node -e "
#     const c = require('crypto');
#     const salt = c.randomBytes(16).toString('hex');
#     const h = c.scryptSync('YOUR_PASSCODE', salt, 64).toString('hex');
#     console.log(salt + ':' + h);
#   "
#
# Paste the output as the value of this variable in your deployment secrets.
ADMIN_PASSWORD_HASH="<salt-hex>:<hash-hex>"
